<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net452;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DanfeSharp</RootNamespace>
    <AssemblyName>DanfeSharp</AssemblyName>
    <NeutralLanguage>pt-BR</NeutralLanguage>

    <PackageId>DanfeSharp.Next</PackageId>
    <Version>3.2.1</Version>
    <Product>DanfeSharp</Product>
    <Description>Gerador em PDF do DANFE (NF-e), DANFE NFC-e, documentos de eventos (carta de correção, cancelamento), DACTE (CT-e) e DANFSe (NFS-e Nacional), com suporte ao IBS, CBS e IS da Reforma Tributária (NT 2025.002 e NT 2026.010).</Description>
    <Copyright>Copyright © 2017 Ricardo Brito, © 2026 Allan Ferreira</Copyright>
    <Authors>Ricardo Brito; Allan Ferreira</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/AllanLinux/DanfeSharp.Next</RepositoryUrl>
    <PackageTags>nfe;danfe;nfce;cte;dacte;nfse;danfse;cce;pdf;ibs;cbs;reforma-tributaria</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DanfeSharp.Test" />
    <!-- Arquivo antigo, sem uso, que nunca fez parte da compilação. -->
    <Compile Remove="Modelo\FaturaViewModel.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Municípios do IBGE (código;nome), para exibir o nome do município na DANFSe. -->
    <EmbeddedResource Include="NFSe\municipios.txt.gz" LogicalName="DanfeSharp.NFSe.municipios.txt.gz" />
    <!-- Logotipo da NFS-e do cabeçalho da DANFSe oficial. -->
    <EmbeddedResource Include="NFSe\logo_nfse.png" LogicalName="DanfeSharp.NFSe.logo_nfse.png" />
  </ItemGroup>

  <!-- .NET Framework 4.5.2: PDFsharp 1.50 (GDI+), que usa as fontes instaladas no Windows. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net452'">
    <PackageReference Include="PDFsharp" Version="1.50.5147" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <!-- .NET 8+: PDFsharp 6, multiplataforma. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

  <!-- QR Code da NFC-e e do CT-e: só a matriz de módulos é usada, o desenho é vetorial. -->
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
